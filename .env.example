# ---- Supabase (self-hosted) — auth. URL + anon key are PUBLIC (safe in browser).
# NEVER put the service_role key in the frontend.
VITE_SUPABASE_URL=https://supabase.myskills.org.in
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Google Analytics 4 (Google tag). PUBLIC id, safe in the browser.
# Leave blank to disable analytics entirely (no gtag.js is loaded).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
