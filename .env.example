# ---- Supabase Cloud — auth. URL + anon key are PUBLIC (safe in browser).
# NEVER put the service_role key in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Google Analytics 4 (Google tag). PUBLIC id, safe in the browser.
# Leave blank to disable analytics entirely (no gtag.js is loaded).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- Meta Pixel (Meta ads). PUBLIC id, safe in the browser: the number in
# Events Manager > Data sources. Leave blank to load nothing.
VITE_META_PIXEL_ID=

