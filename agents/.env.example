# Copy to .env (in this folder, on the server) and fill in. Never commit .env.

# From console.anthropic.com > API keys (a key for the MySkills organisation).
ANTHROPIC_API_KEY=

# The Supabase address, and its service_role key (from the Supabase setup's
# .env on the server: SERVICE_ROLE_KEY). It can read and write everything, so
# it lives only here, never in the website.
SUPABASE_URL=https://supabase.myskills.org.in
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Spending limits in US dollars: a job stops revising when it
# reaches its limit, and no job starts once the month's total is reached.
AGENT_JOB_BUDGET_USD=10
AGENT_MONTHLY_BUDGET_USD=20

# Optional. The Claude model (default claude-opus-5-5).
# AGENT_MODEL=claude-opus-5-5
